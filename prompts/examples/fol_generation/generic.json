{
  "example_set": "fol_generation_generic_v1",
  "leakage_policy": "Synthetic schema names and example URIs only; no evaluation answers, qpair IDs, scores, or copied rules.",
  "examples": [
    {
      "id": "discriminator_class_rule",
      "selected_match": {"match_id": "m_class_flag", "source_id": "source-discriminator:PersonTable.role:author", "target_uri": "ex:Author"},
      "rule": {
        "kind": "class",
        "match_ids": ["m_class_flag"],
        "source_table": "PersonTable",
        "subject_columns": ["person_id"],
        "target_class": "ex:Author",
        "row_filter": {"column": "role", "op": "=", "value": "author"}
      },
      "lesson": "A discriminator match should become a filtered class rule with a row filter grounded in an observed categorical value."
    },
    {
      "id": "datatype_property_rule",
      "selected_match": {"match_id": "m_title", "source_id": "PaperTable.title", "target_uri": "ex:title"},
      "rule": {
        "kind": "data",
        "match_ids": ["m_title"],
        "source_table": "PaperTable",
        "subject_columns": ["paper_id"],
        "source_column": "title",
        "target_property": "ex:title"
      },
      "lesson": "A non-FK literal column should be emitted as a data rule that preserves source-column provenance."
    },
    {
      "id": "fk_object_property_rule",
      "selected_match": {"match_id": "m_author", "source_id": "PaperTable.author_id", "target_uri": "ex:hasAuthor"},
      "rule": {
        "kind": "object",
        "match_ids": ["m_author"],
        "source_table": "PaperTable",
        "subject_columns": ["paper_id"],
        "object_table": "PersonTable",
        "object_columns": ["person_id"],
        "source_fk_columns": ["author_id"],
        "target_property": "ex:hasAuthor"
      },
      "lesson": "An FK-backed relation should use an object rule with schema-grounded subject and object endpoints."
    },
    {
      "id": "join_table_object_property_rule",
      "selected_match": {"match_id": "m_participant", "source_id": "EventPersonTable.person_id", "target_uri": "ex:hasParticipant"},
      "rule": {
        "kind": "object",
        "match_ids": ["m_participant"],
        "source_table": "EventPersonTable",
        "subject_table": "EventTable",
        "subject_columns": ["event_id"],
        "object_table": "PersonTable",
        "object_columns": ["person_id"],
        "join_subject_columns": ["event_id"],
        "join_object_columns": ["person_id"],
        "target_property": "ex:hasParticipant"
      },
      "lesson": "A join table object rule must copy the supplied endpoint fields rather than inventing columns."
    }
  ]
}
