# Host paths for Docker Compose
RODI_DIR=./data
OUTPUT_DIR=./outputs
GOOGLE_GCLOUD_CONFIG_DIR=./.gcloud

# Supply only the provider credentials you use. Never commit .env.
OPENAI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Container path, not host path:
GOOGLE_APPLICATION_CREDENTIALS=/gcloud/application_default_credentials.json
